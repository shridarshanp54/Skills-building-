#include <stdio.h>

void main()
{
    int i, even = 0, odd = 0;

    for(i = 1; i <= 10; i++)
    {
        if(i % 2 == 0)
        {
            even++;
        }
        else
        {
            odd++;
        }
    }

    printf("Even numbers = %d\n", even);
    printf("Odd numbers = %d", odd);
}
